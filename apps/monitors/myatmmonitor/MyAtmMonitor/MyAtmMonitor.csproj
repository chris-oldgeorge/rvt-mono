<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- RVT0001: this module still consumes the legacy IMessageService path;
         retired by legacy-retirement steps 4-5, which also delete this NoWarn. -->
    <NoWarn>$(NoWarn);RVT0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MyAtmMonitorTests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Riok.Mapperly" PrivateAssets="all" OutputItemType="Analyzer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../libs/rvt-monitor-common/src/Rvt.Monitor.Common/Rvt.Monitor.Common.csproj" />
    <ProjectReference Include="../../../../libs/rvt-monitor-common/src/Rvt.Communication.Abstractions/Rvt.Communication.Abstractions.csproj" />
    <ProjectReference Include="../../../../libs/rvt-monitor-common/src/Rvt.Communication/Rvt.Communication.csproj" />
    <ProjectReference Include="../../../../libs/rvt-monitor-common/src/Rvt.Communication.SendGridMail/Rvt.Communication.SendGridMail.csproj" />
    <ProjectReference Include="../../../../libs/rvt-monitor-common/src/Rvt.Communication.MicrosoftGraphMail/Rvt.Communication.MicrosoftGraphMail.csproj" />
    <ProjectReference Include="../../../../libs/rvt-monitor-common/src/Rvt.Communication.TransmitSms/Rvt.Communication.TransmitSms.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="api\db\" />
    <None Remove="api\http\" />
    <None Remove="api\rvt-common\" />
    <None Remove="api\rvt-common\comms\" />
    <None Remove="api\rvt-common\mqtt\" />
    <None Remove="api\rvt-common\util\" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
   <ItemGroup>
    <Folder Include="api\db\" />
    <Folder Include="api\http\" />
    <Folder Include="api\rvt-common\mqtt\" />
    <Folder Include="api\rvt-common\util\" />
  </ItemGroup>
</Project>
